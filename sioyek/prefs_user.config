ui_font Sarasa Term SC Nerd
font_size 20
status_font Sarasa Term SC Nerd
status_bar_font_size 18
flat_toc 0
enable_experimental_features 1
should_use_multiple_monitors 1
collapsed_toc 1
should_launch_new_instance 1
move_screen_ratio 1
# should_draw_unrendered_pages 1
should_load_tutorial_when_no_other_file 1
sort_bookmarks_by_location 1
status_bar_format Page %{current_page} / %{num_pages} %{search_results}%{search_progress}%{link_status}%{waiting_for_symbol}%{indexing}%{preview_index}%{synctex}%{drag}%{presentation}%{visual_scroll}%{locked_scroll}%{highlight}%{closest_bookmark}%{close_portal}%{rect_select}%{custom_message}
# =============== #
background_color              #2e3339
dark_mode_background_color    #2e3339
dark_mode_contrast              0.7

text_highlight_color          #a7c080

search_highlight_color        #2e3339
link_highlight_color          #a7c080
synctex_highlight_color       #a7c080

custom_background_color                   #272e33
custom_text_color                         #d3c6aa
custom_color_mode_empty_background_color  #2e3339
custom_color_contrast           0.9

page_separator_color          #2e3339
page_separator_width             0.8

status_bar_color              #2e3339
status_bar_text_color         #d3c6aa

ui_text_color                 #d3c6aa
ui_background_color           #272e32
ui_selected_text_color        #272e33
ui_selected_background_color  #d3c6aa

# =============== #
super_fast_search 1
startup_commands toggle_custom_color
new_command _dual_panelify python -m sioyek.dual_panelify "%{sioyek_path}" "%{file_path}" "%{command_text}"
new_command _translate_selected_text python /home/moonsea/.config/sioyek/translate.py "%{sioyek_path}" "%{selected_text}"
new_command _translate_current_line_text python /home/moonsea/.config/sioyek/translate.py "%{sioyek_path}" "%{line_text}"
