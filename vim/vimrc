" ============================================================================
" File:        vimrc
" Description: Legacy Vim script config (cleaned/organized version)
" ============================================================================
"
" HOW TO USE
"   Put this at ~/.vimrc or $XDG_CONFIG_HOME/vim/vimrc and restart vim.
"
" REMOVED PLUGINS AND REASONS
"   wikitopian/hardmode           - only rarely useful; disruptive to keep loaded
"   justinmk/vim-sneak            - easymotion covers two-char jump needs
"   tpope/vim-unimpaired          - nice but not needed for this setup
"   tpope/vim-endwise             - language-specific magic; too intrusive
"   godlygeek/tabular             - vim-easy-align covers most alignment cases
"   simnalamburt/vim-mundo        - undo tree can be added back on demand
"   wellle/context.vim            - nice but heavy; can re-enable if needed
"   vim-startify                  - fzf already provides the start screen
"
" ============================================================================
set nocompatible

if has("syntax") && has("eval")
    packadd! matchit
endif
packadd! justify
packadd! helptoc
runtime ftplugin/man.vim

" ---------------------------------------------------------------------------
" Completion plugin variables MUST be set before plug#end() loads the plugins.
" ---------------------------------------------------------------------------
" auto-pairs: disable noisy shortcut toggles (set before auto-pairs loads)
let g:AutoPairsShortcutToggle = ""
let g:AutoPairsShortcutFastWrap = ""
let g:AutoPairsShortcutBackInsert = ""
let g:AutoPairsShortcutJump = ""
" We orchestrate <CR> and <Space> manually so mucomplete / UltiSnips /
" auto-pairs do not fight over those keys.  Their auto-pairs behaviors
" are still explicitly invoked via <Plug>AutoPairsReturn / AutoPairsSpace().
let g:AutoPairsMapCR = 0
let g:AutoPairsMapSpace = 0

" UltiSnips: keep snippet keys away from Tab (set before UltiSnips maps keys)
let g:UltiSnipsExpandTrigger = "<C-j>"
let g:UltiSnipsJumpForwardTrigger = "<C-j>"
let g:UltiSnipsJumpBackwardTrigger = "<C-k>"
let g:UltiSnipsListSnippets = "<C-l>"
let g:UltiSnipsEditSplit = "vertical"

" mucomplete: disable its own <Tab> mappings because we define them ourselves
let g:mucomplete#no_mappings = 1
let g:mucomplete#enable_auto_at_startup = 1
let g:mucomplete#chains = {
    \ 'vim':     ['path', 'omni', 'keyn', 'ulti'],
    \ 'default': ['path', 'omni', 'keyn', 'dict', 'uspl', 'ulti'],
    \ 'tex':     ['ulti', 'omni', 'path'],
    \}

filetype off
call plug#begin()
    " --- search / open -------------------------------
    Plug 'junegunn/fzf', { 'do': { -> fzf#install() } }
    Plug 'junegunn/fzf.vim'
    Plug 'romainl/vim-cool'               " Disables highlight when search is done

    " --- movement -------------------------------------
    Plug 'easymotion/vim-easymotion'

    " --- text objects / editing -----------------------
    Plug 'tpope/vim-surround'
    Plug 'tpope/vim-repeat'
    Plug 'tpope/vim-commentary'
    Plug 'junegunn/vim-easy-align'
    Plug 'foosoft/vim-argwrap'

    " --- completion -----------------------------------
    Plug 'SirVer/ultisnips'
    Plug 'honza/vim-snippets'
    Plug 'https://codeberg.org/lifepillar/vim-mucomplete'
    Plug 'jiangmiao/auto-pairs'
    Plug 'KeitaNakamura/tex-conceal.vim', { 'for': 'tex' }

    " --- file / project -------------------------------
    Plug 'preservim/nerdtree'
    Plug 'tpope/vim-eunuch'

    " --- UI -------------------------------------------
    Plug 'majutsushi/tagbar'
    Plug 'frazrepo/vim-rainbow'
    Plug 'liuchengxu/vim-which-key'
    Plug 'itchyny/lightline.vim'
    Plug 'machakann/vim-highlightedyank'
    Plug 'andymass/vim-matchup'
    Plug 'kshenoy/vim-signature'

    " --- git ------------------------------------------
    Plug 'airblade/vim-gitgutter'
    Plug 'tpope/vim-fugitive'
    Plug 'tpope/vim-rhubarb'
    Plug 'junegunn/gv.vim'

    " --- tmux -----------------------------------------
    Plug 'tmux-plugins/vim-tmux-focus-events'
    Plug 'roxma/vim-tmux-clipboard'
    Plug 'christoomey/vim-tmux-navigator'

    " --- language / syntax / lint ---------------------
    Plug 'w0rp/ale'
    Plug 'maximbaz/lightline-ale'
    Plug 'lervag/vimtex'
    Plug 'kaarmu/typst.vim'
    Plug 'imsnif/kdl.vim'
    Plug 'plasticboy/vim-markdown'
    Plug 'chrisbra/colorizer'
    Plug 'isobit/vim-caddyfile'

    " --- writing --------------------------------------
    Plug 'junegunn/goyo.vim'
    Plug 'junegunn/limelight.vim'

    " --- native helpers -------------------------------
    Plug 'voldikss/vim-translator'

    " --- colorscheme (only one kept active) -----------
    Plug 'cocopon/iceberg.vim'
    Plug 'sainnhe/everforest'
    Plug 'catppuccin/vim', { 'as': 'catppuccin' }
    Plug 'ghifarit53/tokyonight-vim'
call plug#end()

filetype plugin on
filetype indent on
syntax on

" ============================================================================
" 2. Appearance / colorscheme
" ============================================================================
set termguicolors
set t_Co=256
set background=dark
colorscheme everforest

let g:rainbow_active = 1
set noshowmode
set laststatus=2

if has("gui_running")
    set guifont=CodeNewRoman\ Nerd\ Font\ 15
    set guioptions=mgT
endif

" ============================================================================
" 3. Editor basics
" ============================================================================
set encoding=utf-8
set fileencodings=utf-8,gbk,gb2312,latin1
set textwidth=0
set linebreak
set wrap
set autoindent
set cindent
set smartindent
set tabstop=4
set softtabstop=4
set shiftwidth=4
set expandtab
set backspace=indent,eol,start

set mouse=a
set clipboard=unnamedplus
set modeline

set ruler
set showcmd
set number
set relativenumber
set cursorline
set cursorlineopt=both
set colorcolumn=+2
set list
set listchars=tab:>\ ,trail:-,extends:>,precedes:<
set shortmess+=I
set showmatch
set scrolloff=8
set updatetime=200
set ttyfast
set splitright
set splitbelow
set signcolumn=yes
set hidden
set completeopt=menu,menuone,noselect,popup

" ============================================================================
" 4. Search settings
" ============================================================================
set incsearch
set hlsearch
set ignorecase
set smartcase
set nowrapscan
set wildignore+=*/.git/*,*/tmp/*,*.swp

" Recenter after common search movements
nnoremap <silent> n nzz
nnoremap <silent> N Nzz
nnoremap <silent> * *zz
nnoremap <silent> # #zz
nnoremap <silent> g* g*zz
nnoremap <C-o> <C-o>zz
nnoremap <C-i> <C-i>zz

" <C-h> manual clear-search-highlight is intentionally left disabled;
" vim-cool automatically disables hlsearch after a search settles.
" Re-enable only if you prefer manual control:
" nnoremap <silent> <C-h> :nohlsearch<CR>

" ============================================================================
" 5. Persistence: undo / backup
" ============================================================================
if has("persistent_undo")
    let s:undodir = expand("~/.config/vim/undodir")
    if !isdirectory(s:undodir)
        call mkdir(s:undodir, "p")
    endif
    set undodir=~/.config/vim/undodir
    set undofile
endif
set nobackup
set nowritebackup

" ============================================================================
" 6. Folding
" ============================================================================
set foldenable
set foldlevelstart=10
set foldnestmax=10
set foldmethod=indent

" ============================================================================
" 7. Leader / general key mappings
" ============================================================================
let g:mapleader = " "
let g:maplocalleader = ","
set timeoutlen=700

nnoremap <Leader>tn :tabnew<CR>
nnoremap <Leader>x  :tabclose<CR>
nnoremap <Leader>bn :bn<CR>
nnoremap <Leader>bp :bp<CR>
nnoremap <Leader>bd :bd<CR>
nnoremap <Leader>hc :helpclose<CR>
nnoremap <Leader>bl :ls<CR>
nnoremap <Leader>e  :edit $MYVIMRC<CR>
nnoremap <Leader>s  :source $MYVIMRC<CR>

" Window / NERDTree
nnoremap <silent> <C-n> :NERDTreeToggle<CR>

" Tagbar
nnoremap <silent> <C-u> :TagbarToggle<CR>

" Goyo / limelight
nnoremap <C-g> :Goyo<CR>

" Translation
nmap <silent> <Leader>tt <Plug>Translate
vmap <silent> <Leader>tt <Plug>TranslateV
nnoremap <silent> <Leader>tw <Plug>TranslateW
vnoremap <silent> <Leader>tw <Plug>TranslateWV

" --- alignment / argument wrapping -------------------
" <Leader>ag : vim-easy-align. In Normal mode follow with a motion; in
"              Visual mode selection is already made by the time you hit it.
nmap <silent> <Leader>ag <Plug>(EasyAlign)
xmap <silent> <Leader>ag <Plug>(EasyAlign)
" <Leader>aw : vim-argwrap. Toggle wrapping function arguments between one
"              line and one-line-per-argument.
nnoremap <silent> <Leader>aw :ArgWrap<CR>

" --- git (fugitive / gv.vim) -------------------------
" g* commands use <Leader>g prefix.  (Do not confuse with fzf's <Leader>fg,
" which is GitFiles — that one is under the fzf <Leader>f family.)
" <Leader>gs = git status window
nnoremap <silent> <Leader>gs  :Gstatus<CR>
" <Leader>gd = diff current file
nnoremap <silent> <Leader>gd  :Gdiffsplit<CR>
" <Leader>gb = blame current file
nnoremap <silent> <Leader>gb  :Gblame<CR>
" <Leader>gl = repository commit graph
nnoremap <silent> <Leader>gl  :GV<CR>
" <Leader>gw = stage / write file to git
nnoremap <silent> <Leader>gw  :Gwrite<CR>

" --- fzf.vim shortcuts -------------------------------
" Multi-key chords are written with NO space after the prefix, e.g. the
" <Leader> f i chord is <Leader>fi; Vim waits for the complete chord.
" <Leader>f + <first letter> for the main fzf commands:
nnoremap <silent> <Leader>ff  :Files<CR>
nnoremap <silent> <Leader>fi  :History<CR>
nnoremap <silent> <Leader>fb  :Buffers<CR>
nnoremap <silent> <Leader>fc  :Commands<CR>
nnoremap <silent> <Leader>fl  :BLines<CR>
nnoremap <silent> <Leader>fr  :Rg<CR>
nnoremap <silent> <Leader>fg  :GitFiles<CR>
nnoremap <silent> <Leader>ft  :Tags<CR>
nnoremap <silent> <Leader>fs  :Snippets<CR>
nnoremap <silent> <Leader>fj  :Jumps<CR>
nnoremap <silent> <Leader>fm  :Marks<CR>
nnoremap <silent> <Leader>fw  :Windows<CR>
" Other fzf entry points:
nnoremap <silent> <Leader>tf  :Filetypes<CR>
nnoremap <silent> <Leader>lf  :Lines<CR>
nnoremap <silent> <Leader>ll  :Locate<CR>
nnoremap <silent> <Leader>hh  :Helptags<CR>
nnoremap <silent> <Leader>th  :Colors<CR>
nnoremap <silent> <Leader>mm  :Maps<CR>


" easymotion
nmap <Leader><Leader>f <Plug>(easymotion-overwin-f)
nmap <Leader><Leader>s <Plug>(easymotion-overwin-f2)
nmap <Leader><Leader>l <Plug>(easymotion-overwin-line)
nmap <Leader><Leader>w <Plug>(easymotion-overwin-w)

" ============================================================================
" 8. Which-key
" ============================================================================
nnoremap <silent> <leader>      :WhichKey ' ' <CR>
xnoremap <silent> <leader>      :WhichKeyVisual ' ' <CR>
nnoremap <silent> <localleader> :WhichKey ',' <CR>
xnoremap <silent> <localleader> :WhichKeyVisual ',' <CR>

" ============================================================================
" 9. Completion optimization (mucomplete + UltiSnips + auto-pairs)
" ============================================================================
" NOTE: all plugin -specific variables are configured BEFORE plug#begin()
"       so they take effect when plugins are loaded by plug#end().
"       Here we only define the cooperation mappings.

" Tab / S-Tab: forward/backward in the mucomplete popup.
" (mucomplete#no_mappings is set above, so these are the ONLY <Tab> bindings)
imap <silent> <Tab>   <Plug>(MUcompleteFwd)
imap <silent> <S-Tab> <Plug>(MUcompleteBwd)

" <CR> cooperation (mucomplete + UltiSnips + auto-pairs):
"   - if a completion popup is visible:
"       <C-y> accepts the item; if it is a '[snip]' candidate from the
"       mucomplete 'ulti' chain, UltiSnips#ExpandSnippet() is invoked too
"       and remains in Insert mode for placeholder jumping.
"       AutoPairsReturn is NOT executed here, because its <Esc>-based
"       handling would kick us out of the just-expanded snippet.
"   - otherwise:
"       do a normal <CR> and then auto-pairs' AutoPairsReturn (bracket
"       return indent).  The <CR> is returned directly by the expr mapping
"       so it is not recursively re-mapped.
function! CompleteCRUltiExpand() abort
  if pumvisible()
    " popup open → official mucomplete path handles both ordinary
    " completion (accept only, no newline) and [snip] expansion.
    return mucomplete#ultisnips#expand_snippet("")
  endif
  return "\<CR>\<Plug>AutoPairsReturn"
endfunction
inoremap <silent> <expr> <Plug>UltiExpand CompleteCRUltiExpand()
imap <CR> <Plug>UltiExpand

" <Space> cooperation: because g:AutoPairsMapSpace=0 above, re-invoke
" AutoPairsSpace() when there is no completion popup, otherwise leave the
" <Space> to normal input/completion.
imap <silent> <expr> <Space> pumvisible()
      \ ? "\<Space>"
      \ : "\<C-r>=AutoPairsSpace()\<CR>"

" ============================================================================
" 10. ALE
" ============================================================================
let g:ale_enabled = 1
let g:ale_lint_on_enter = 1
let g:ale_lint_on_save = 1
let g:ale_lint_on_text_changed = "never"
let g:ale_fix_on_save = 1
let g:ale_float_preview = 1
let g:ale_fixers = {
    \ '*': ['remove_trailing_lines', 'trim_whitespace'],
    \ 'javascript': ['prettier'],
    \ 'css': ['prettier'],
    \ 'html': ['prettier'],
    \ 'markdown': ['prettier'],
    \ 'json': ['prettier'],
    \ 'yaml': ['prettier'],
    \}
nmap <silent> [a <Plug>(ale_previous_wrap)
nmap <silent> ]a <Plug>(ale_next_wrap)

" ============================================================================
" 11. VimTeX / TeX
" ============================================================================
let g:tex_flavor = "lualatex"
let g:tex_conceal = "abdmg"
set conceallevel=1
set ambiwidth=double
highlight Conceal ctermbg=none
syntax enable
let g:vimtex_view_method = "sioyek"
let g:vimtex_compiler_method = "latexmk"
let g:vimtex_compiler_latexmk = {
    \ 'callback': 0,
    \ 'continuous': 0,
    \}
let g:vimtex_compiler_latexmk_engines = { '_': '-lualatex' }

augroup vimrc_tex
    autocmd!
    autocmd FileType tex setlocal conceallevel=0
    autocmd FileType tex setlocal spell
augroup END

" ============================================================================
" 12. Filetype specific augroups (all grouped, no naked autocmd!)
" ============================================================================
augroup vimrc_text
    autocmd!
    autocmd FileType text,markdown,tex setlocal textwidth=78
    autocmd FileType text,markdown,tex setlocal linebreak
    autocmd FileType text,markdown,tex setlocal spell
    autocmd FileType text,markdown,tex nnoremap <buffer> j gj
    autocmd FileType text,markdown,tex nnoremap <buffer> k gk
augroup END

augroup vimrc_overwrite
    autocmd!
    " Reload config easier when editing this file
    autocmd BufWritePost .vimrc,vimrc source <afile>
augroup END

" ============================================================================
" 13. Misc / convenience
" ============================================================================
" Help in vertical window for :Man
let g:ft_man_open_mode = "vert"

" Lightline + ALE status (single dict assignment, no nested-let pitfalls)
let g:lightline = {
    \ 'colorscheme': 'everforest',
    \ 'component_expand': {
    \     'linter_warnings': 'lightline#ale#warnings',
    \     'linter_errors': 'lightline#ale#errors',
    \ },
    \ 'component_type': {
    \     'linter_warnings': 'warning',
    \     'linter_errors': 'error',
    \ },
    \ 'active': {
    \     'left': [
    \         ['mode', 'paste'],
    \         ['readonly', 'filename', 'modified'],
    \         ['linter_warnings', 'linter_errors'],
    \     ],
    \ },
    \}
augroup vimrc_status
    autocmd!
    autocmd User ALELint,LightlineUpdate call lightline#update()
augroup END

" Limelight integrated with Goyo
let g:limelight_conceal_ctermfg = "gray"
augroup vimrc_goyo
    autocmd!
    autocmd User GoyoEnter Limelight
    autocmd User GoyoLeave Limelight!
augroup END

" NERDTree opens when vim starts with a directory argument
function! StartNerdTreeFromArg()
    if argc() != 1 || !isdirectory(argv()[0])
        return
    endif
    execute 'NERDTree' argv()[0]
    wincmd p
    enew
    execute 'cd ' . argv()[0]
endfunction
augroup vimrc_nerdtree
    autocmd!
    autocmd VimEnter * call StartNerdTreeFromArg()
augroup END

" Open help and man pages in a vertical split on the LEFT side
augroup vimrc_help_man_left
    autocmd!
    autocmd FileType help wincmd H
    autocmd FileType man wincmd H
augroup END
