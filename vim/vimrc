vim9script
# ============================================================================
# File:        vimrc
# Description: Main Vim configuration file (fully Vim9script)
# 描述：Vim 主配置文件（完全 Vim9script 写法）
# ============================================================================
#

# EXTERNAL DEPENDENCIES / 外部依赖
#   The following external commands are needed by some mappings/plugins.
#   以下外部命令会被某些映射 / 插件调用，需提前安装：
#   - fzf        : used by :Files, :History, etc.
#   - rg         : used by :Rg (ripgrep full-text search)
#   - locate     : used by :Locate; on Gentoo install plocate or mlocate
#   - git        : used by fugitive / gv.vim / GitFiles
#   - lualatex   : used by VimTeX (latexmk with lualatex engine)
#   - python3    : required by UltiSnips snippet engine
#
# REMOVED PLUGINS AND REASONS / 已移除插件及原因
#   justinmk/vim-sneak            - easymotion covers two-char jump;
#   easymotion 已覆盖双字符跳转
#   tpope/vim-unimpaired          - nice but not needed;
#   有部分帮助但当前不需要
#   tpope/vim-endwise             - language-specific magic;
#   语言相关自动补全，过于侵入
#   godlygeek/tabular             - vim-easy-align covers alignment; 对齐由
#   vim-easy-align 提供
#   wellle/context.vim            - nice but heavy; 功能好但偏重
#
# BUILT-IN REPLACEMENTS / 由 Vim 内置功能替代的插件
#   tpope/vim-commentary          -> packadd! comment   (gc/gcc, ic/ac text
#   objects)
#   romainl/vim-cool              -> packadd! nohlsearch (auto clear hlsearch)
#   machakann/vim-highlightedyank -> packadd! hlyank     (highlight yanked
#   region)
#   kaarmu/typst.vim              -> autoload/typst.vim (built-in
#   syntax/indent; no build/preview)
#
# ============================================================================
&compatible = false

execute 'packadd! justify'
execute 'packadd! helptoc'
execute 'packadd! comment'
# execute 'packadd! nohlsearch' # vim-cool
execute 'packadd! hlyank'
execute 'packadd! helpcurwin'
execute 'packadd! cfilter'
execute 'packadd! shellmenu'
execute 'packadd! editexisting'
execute 'runtime ftplugin/man.vim'
# Load the built-in man page ftplugin. / 加载内置 man 帮助文件类型插件。

# ---------------------------------------------------------------------------
# Completion plugin variables MUST be set before plug#end() loads the plugins.
# 补全插件的变量必须写在 plug#end() 加载插件之前才会生效。
# ---------------------------------------------------------------------------
# auto-pairs: disable noisy shortcut toggles (must be set before plugins load).
# auto-pairs：关闭较嘈杂的快捷键开关（必须在插件加载前设置）。
g:AutoPairsShortcutToggle = ''
g:AutoPairsShortcutFastWrap = ''
g:AutoPairsShortcutBackInsert = ''
g:AutoPairsShortcutJump = ''

# We orchestrate <CR>/<Space> manually so mucomplete / UltiSnips / auto-pairs
# do not fight over those keys.  auto-pairs' return/space logic is still
# explicitly invoked via <Plug>AutoPairsReturn / AutoPairsSpace().
# 我们手动编排 <CR>/<Space>，避免 mucomplete / UltiSnips / auto-pairs
# 争抢按键。
# auto-pairs 的回车 / 空格逻辑仍通过 <Plug>AutoPairsReturn / AutoPairsSpace()
# 显式调用。
g:AutoPairsMapCR = 0
g:AutoPairsMapSpace = 0

# UltiSnips: use C-j/C-k so Tab stays available for mucomplete.
# UltiSnips：使用 C-j/C-k，把 Tab 留给 mucomplete 前后切换。
g:UltiSnipsExpandTrigger = '<C-j>'
g:UltiSnipsJumpForwardTrigger = '<C-j>'
g:UltiSnipsJumpBackwardTrigger = '<C-k>'
g:UltiSnipsListSnippets = '<C-l>'
g:UltiSnipsEditSplit = 'vertical'

# mucomplete: we define <Tab>/<S-Tab> ourselves, disable its built-ins.
# mucomplete：我们自行定义 <Tab>/<S-Tab>，关闭其内置映射。
g:mucomplete#no_mappings = 1
g:mucomplete#enable_auto_at_startup = 1
g:mucomplete#chains = {
    'vim':     ['omni', 'ulti', 'path', 'keyn'],
    'default': ['omni', 'ulti', 'path', 'keyn', 'dict', 'uspl'],
    'tex':     ['omni', 'ulti', 'path'],
    }
g:mucomplete#can_complete = {}
# 'default' key must exist; otherwise unlisted filetypes hit E716.
# 必须包含 'default' 键，否则未显式列出的文件类型会触发 E716。
g:mucomplete#can_complete.default = {}
g:mucomplete#can_complete.tex = {'omni': (t) => t =~# g:vimtex#re#neocomplete .. '$'}

# vim-mundo: visual undo tree. Prefer python3 (it needs a Python interface).
# vim-mundo：可视化撤销树。优先使用 python3（依赖 Python 接口）。
g:mundo_prefer_python3 = 1
# Open the undo tree on the right side. / 撤销树在右侧打开。
g:mundo_right = 1
# Keep the tree/preview narrow and tidy. / 让树与预览窗口更紧凑。
g:mundo_width = 40
g:mundo_preview_height = 15

# vim-matchup: do NOT hijack the statusline when the match is off-screen.
# matchparen replaces the window-local 'statusline' with its own
# `%{matchup#matchparen#scroll_update(...)}` prompt whenever the matching
# open/close of a def/if block is outside the visible area, which makes the
# statusline look like unrelated/warning text.  Disable that behaviour.
# vim-matchup：当匹配的开/闭边界在屏幕外时，不要覆盖状态栏。matchparen 会把
# window-local 'statusline' 换成自己的
# `%{matchup#matchparen#scroll_update(...)}` 提示， 使状态栏看起来像无关 /
# 警告文字。 关闭该行为。

g:matchup_matchparen_status_offscreen = 0

execute 'filetype off'
plug#begin()
    # --- statusline / 状态栏 -------------------------
    Plug 'EssenSea/mutedstl'

    # --- search / open ------------------------------
    # --- 搜索 / 打开 --------------------------------
    Plug 'junegunn/fzf', { 'do': { -> fzf#install() } }
    Plug 'junegunn/fzf.vim'
    Plug 'romainl/vim-cool'

    # --- movement ------------------------------------
    # --- 移动 --------------------------------------
    Plug 'easymotion/vim-easymotion'
    Plug 'wikitopian/hardmode'
    # hardmode: disables arrow/hjkl navigation to force advanced motions

    # --- text objects / editing -----------------------
    # --- 文本对象 / 编辑 ------------------------------
    Plug 'machakann/vim-sandwich'
    # Use 'sandwich' replaces 'surround'.
    Plug 'tpope/vim-repeat'
    # let . repeat plugin actions
    Plug 'simnalamburt/vim-mundo'
    # visual undo tree (undo history graph)
    Plug 'junegunn/vim-easy-align'
    # alignment tool
    # 对齐工具
    Plug 'foosoft/vim-argwrap'
    # toggle argument wrapping
    # 切换函数参数的单行/多行形式

    # --- completion -----------------------------------
    # --- 补全 ----------------------------------------
    Plug 'SirVer/ultisnips'
    Plug 'honza/vim-snippets'
    Plug 'https://codeberg.org/lifepillar/vim-mucomplete'
    Plug 'jiangmiao/auto-pairs'
    Plug 'KeitaNakamura/tex-conceal.vim', { 'for': 'tex' }

    # --- file / project -------------------------------
    # --- 文件 / 工程 ----------------------------------
    # Plug 'preservim/nerdtree'
    Plug 'tpope/vim-eunuch'

    # --- UI ------------------------------------------
    # --- 界面 ----------------------------------------
    Plug 'majutsushi/tagbar'
    Plug 'frazrepo/vim-rainbow'
    Plug 'liuchengxu/vim-which-key'
    # Plug 'itchyny/lightline.vim'   " disabled: use native mutedstl
    Plug 'andymass/vim-matchup'
    Plug 'kshenoy/vim-signature'

    # --- git ------------------------------------------
    # --- 版本控制 -------------------------------------
    Plug 'airblade/vim-gitgutter'
    Plug 'tpope/vim-fugitive'
    Plug 'tpope/vim-rhubarb'
    Plug 'junegunn/gv.vim'

    # --- tmux -----------------------------------------
    # --- tmux -----------------------------------------
    Plug 'roxma/vim-tmux-clipboard'
    Plug 'christoomey/vim-tmux-navigator'

    # --- language / syntax / lint ----------------------
    # --- 语言 / 语法 / 检查 ----------------------------
    Plug 'w0rp/ale'
    # Plug 'maximbaz/lightline-ale'  " disabled: use native mutedstl
    Plug 'lervag/vimtex'
    # (removed) kaarmu/typst.vim -> built-in autoload/typst.vim
    Plug 'imsnif/kdl.vim'
    Plug 'plasticboy/vim-markdown'
    Plug 'chrisbra/colorizer'
    Plug 'isobit/vim-caddyfile'

    # --- writing --------------------------------------
    # --- 写作 / 专注 ------------------------------------
    Plug 'EssenSea/zen.vim'
    # Plug 'junegunn/goyo.vim'
    Plug 'junegunn/limelight.vim'

    # --- native helpers -------------------------------
    # --- 原生辅助工具 ----------------------------------
    Plug 'voldikss/vim-translator'

    # --- colorschemes (everforest active; others via :Colors)
    # --- 配色方案（everforest 当前启用，其余通过 :Colors 切换）
    Plug 'cocopon/iceberg.vim'
    Plug 'sainnhe/everforest'
    # Plug 'catppuccin/vim', { 'as': 'catppuccin' }
    # Plug 'ghifarit53/tokyonight-vim'
plug#end()

execute 'filetype plugin on'
execute 'filetype indent on'
execute 'syntax on'

# ============================================================================
# 2. Appearance / colorscheme / 外观与配色
# ============================================================================
# Native terminal focus-event support (Vim >= 8.2.2345).
# Vim 原生终端焦点事件支持（Vim >= 8.2.2345）。
# tmux must have 'focus-events on' (tmux-sensible enables it automatically).
# 要求 tmux 开启 focus-events（tmux-sensible 会自动开启）。
if !has('gui_running') && &term =~# '^\%(screen\|tmux\)'
    # Enable focus-event tracking: CSI ? 1004 h/l
    # 启用焦点事件跟踪：CSI ? 1004 h/l
    &t_fe = "\<Esc>[?1004h"
    &t_fd = "\<Esc>[?1004l"
    execute "set <FocusGained>=\<Esc>[I"
    execute "set <FocusLost>=\<Esc>[O"
endif

&termguicolors = true
&t_Co = '256'
&background = 'dark'
g:everforest_transparent_background = 0
execute 'colorscheme everforest'

g:rainbow_active = 1
# Rainbow parentheses on. / 开启彩虹括号。

&showmode = false
&laststatus = 2
# Always show a statusline. / 始终显示状态栏。

if has('gui_running')
    &guifont = 'CodeNewRoman Nerd Font 15'
    &guioptions = 'mgT'
endif

# ============================================================================
# 3. Editor basics / 编辑器基础
# ============================================================================
&encoding = 'utf-8'
&fileencodings = 'utf-8,gbk,gb2312,latin1'
&textwidth = 78
&linebreak = true
&wrap = true
&autoindent = true
&cindent = true
&smartindent = true
&tabstop = 4
&softtabstop = 4
&shiftwidth = 4
&expandtab = true
&backspace = 'indent,eol,start'
&spelllang = 'en,cjk'

&mouse = 'a'
&clipboard = 'unnamedplus'
&modeline = true

&ruler = true
&showcmd = true
&number = true
&relativenumber = true
&cursorline = true
&cursorlineopt = 'both'
&colorcolumn = '+1,+2'
&list = true
&listchars = 'tab::=>,trail:+,nbsp:-'
&shortmess ..= 'I'
&showmatch = true
&scrolloff = 2
&updatetime = 2000
&ttyfast = true
# &splitright = true
&splitright = false
&splitbelow = true
&signcolumn = 'yes'
&hidden = true
&wildoptions = 'pum'
&completeopt = 'fuzzy,menu,menuone,noselect,popup'
&pumopt = 'opacity:100,width:30,height:15,border:round,margin'
&completepopup = 'align:item,opacity:100,shadow:on,width:78,border:round'
&confirm = true
&virtualedit = 'block,onemore'
&showbreak = '>'

# ============================================================================
# 4. Search settings / 搜索设置
# ============================================================================
&incsearch = true
&hlsearch = true
&ignorecase = true
&smartcase = true
&wrapscan = false
&wildignore ..= '*/.git/*,*/tmp/*,*.swp'

# Recenter after common search movements / 搜索/跳转后自动居中
# Generated from a typed list to keep the pure-Vim9 style.
var search_recenter: list<list<string>> = [
    ['n', 'nzz'],
    ['N', 'Nzz'],
    ['*', '*zz'],
    ['#', '#zz'],
    ['g*', 'g*zz'],
    ['<C-o>', '<C-o>zz'],
    ['<C-i>', '<C-i>zz'],
    ]
for [lhs, rhs] in search_recenter
    execute 'nnoremap <silent> ' .. lhs .. ' ' .. rhs
endfor

# ============================================================================
# 5. Persistence: undo / backup / 持久化：撤销与备份
# ============================================================================
if has('persistent_undo')
    var undodir = expand('~/.config/vim/undodir')
    if !isdirectory(undodir)
        mkdir(undodir, 'p')
    endif
    &undodir = '~/.config/vim/undodir'
    &undofile = true
endif
&backup = false
&writebackup = false

# ============================================================================
# 6. Folding / 折叠
# ============================================================================
&foldenable = true
&foldlevelstart = 10
&foldnestmax = 10
&foldmethod = 'indent'

# ============================================================================
# 7. Leader / general key mappings / Leader 与常用快捷键
# ============================================================================
g:mapleader = ' '
g:maplocalleader = ','
&timeoutlen = 1000

# Window/tab/buffer basics / 窗口、标签页、缓冲区基础操作
var win_tab_buf_maps: list<list<string>> = [
    ['<Leader>tn', ':tabnew<CR>'],       # new tab / 新标签页
    ['<Leader>x',  ':tabclose<CR>'],     # close tab / 关闭标签页
    ['<Leader>bn', ':bn<CR>'],           # next buffer / 下一个缓冲区
    ['<Leader>bp', ':bp<CR>'],           # previous buffer / 上一个缓冲区
    ['<Leader>bd', ':bd<CR>'],           # delete buffer / 删除缓冲区
    ['<Leader>hc', '<Plug>HelpCurwin;'],
    ['<Leader>ht', '<Cmd>HelpToc<CR>'],  # HelpToc / help 文档目录开关
    ['<Leader>hx', ':helpclose<CR>'],    # close help / 关闭帮助窗口
    ['<Leader>bl', ':ls<CR>'],           # list buffers / 列出缓冲区
    ['<Leader>e',  ':edit $MYVIMRC<CR>'],  # edit vimrc / 编辑 vimrc
    ['<Leader>u',  ':MundoToggle<CR>'],  # toggle the visual undo tree
    ]
for [lhs, rhs] in win_tab_buf_maps
    execute 'nnoremap ' .. lhs .. ' ' .. rhs
endfor

# NERDTree toggle / NERDTree 开关
# nnoremap <silent> <C-n> :NERDTreeToggle<CR>

# Tagbar toggle / Tagbar 开关（函数/类列表）
execute 'nnoremap <silent> <C-u> :TagbarToggle<CR>'

# Goyo: distraction-free writing
# Goyo：无干扰写作模式
# execute 'nnoremap <silent> <Leader>go :Goyo<CR>'
execute 'nnoremap <silent> <Leader>ze <Plug>(zen-toggle)'

# Translation / 翻译（vim-translator）
# <Leader>tt = translate word/selection / 翻译单词或选区
execute 'nmap <silent> <Leader>tt <Plug>Translate'
execute 'vmap <silent> <Leader>tt <Plug>TranslateV'
# <Leader>tw = translate word under cursor / 翻译光标下单词
execute 'nnoremap <silent> <Leader>tw <Plug>TranslateW'
execute 'vnoremap <silent> <Leader>tw <Plug>TranslateWV'

# --- alignment / argument wrapping -------------------
# --- 对齐 / 参数折行 --------------------------------
# <Leader>ag : vim-easy-align. Normal mode: follow with motion.
#              Visual mode: selection already made.
# <Leader>ag：vim-easy-align 对齐。普通模式先触发再给 motion；
#             可视模式选中后触发即可。
execute 'nmap <silent> <Leader>ag <Plug>(EasyAlign)'
execute 'xmap <silent> <Leader>ag <Plug>(EasyAlign)'
# <Leader>aw : vim-argwrap toggle between single-line and multi-line args.
# <Leader>aw：vim-argwrap 在“函数参数单行/多行”之间切换。
execute 'nnoremap <silent> <Leader>aw :ArgWrap<CR>'

# --- git (fugitive / gv.vim) -------------------------
# --- Git（fugitive / gv.vim）-------------------------
# <Leader>gs = git status / git 状态窗口
# <Leader>gd = diff current file / 比较当前文件改动
# <Leader>gb = blame current file / 查看当前文件 blame
# <Leader>gl = commit graph / 仓库提交历史图
# <Leader>gw = stage/write file / 暂存并写入当前文件
var git_maps: list<list<string>> = [
    ['<Leader>gs', ':G<CR>'],
    ['<Leader>gd', ':Gdiffsplit<CR>'],
    ['<Leader>gb', ':Git blame<CR>'],
    ['<Leader>gl', ':GV<CR>'],
    ['<Leader>gw', ':Gwrite<CR>'],
    ]
for [lhs, rhs] in git_maps
    execute 'nnoremap <silent> ' .. lhs .. ' ' .. rhs
endfor

# --- fzf.vim shortcuts -------------------------------
# --- fzf.vim 快捷键 --------------------------------
# Multi-key chords: NO space after the prefix, e.g. <Leader>fi = <Space> f i.
# 多键组合写法：<Leader> 后不加空格，如 <Leader>fi 即依次按 <Space> f i。
# <Leader>f + <identifier> for the main fzf commands / 主要 fzf 命令：
# Other fzf entry points / 其它 fzf 入口：
var fzf_maps: list<list<string>> = [
    ['<Leader>ff', ':Files<CR>',     'Files / 文件搜索'],
    ['<Leader>fi', ':History<CR>',   'History / 最近文件历史'],
    ['<Leader>fb', ':Buffers<CR>',   'Buffers / 缓冲区切换'],
    ['<Leader>fc', ':Commands<CR>',  'Commands / Ex 命令面板'],
    ['<Leader>fl', ':BLines<CR>',    'BLines / 当前文件行搜索'],
    ['<Leader>fr', ':Rg<CR>',        'Rg / ripgrep 全文搜索'],
    ['<Leader>fg', ':GitFiles<CR>',  'GitFiles / git 跟踪文件'],
    ['<Leader>ft', ':Tags<CR>',      'Tags / 项目 tags 符号'],
    ['<Leader>fs', ':Snippets<CR>',  'Snippets / 代码片段'],
    ['<Leader>fj', ':Jumps<CR>',     'Jumps / 跳转历史'],
    ['<Leader>fm', ':Marks<CR>',     'Marks / 标记列表'],
    ['<Leader>fw', ':Windows<CR>',   'Windows / 窗口列表'],
    ['<Leader>tf', ':Filetypes<CR>', 'Filetypes / 文件类型'],
    ['<Leader>lf', ':Lines<CR>',     'Lines / 所有 buffer 行'],
    ['<Leader>ll', ':Locate<CR>',    'Locate / locate 系统文件'],
    ['<Leader>hh', ':Helptags<CR>',  'Helptags / 帮助标签'],
    ['<Leader>th', ':Colors<CR>',    'Colors / 配色主题'],
    ['<Leader>mm', ':Maps<CR>',      'Maps / 按键映射列表'],
    ]
for [lhs, rhs, _desc] in fzf_maps
    execute 'nnoremap <silent> ' .. lhs .. ' ' .. rhs
endfor
execute 'noremap <silent> <leader>f: :History:<CR>'
execute 'noremap <silent> <leader>f/ :History/<CR>'

# HardMode toggle: <Leader>ht
# HardMode 开关：<Leader>ht
execute 'nnoremap <silent> <Leader>ha :call ToggleHardMode()<CR>'

# easymotion / 快速跳转
# <Leader><Leader> + f/s/l/w 开头的跳转
var easymotion_maps: list<list<string>> = [
    ['f', '<Plug>(easymotion-overwin-f)'],
    ['s', '<Plug>(easymotion-overwin-f2)'],
    ['l', '<Plug>(easymotion-overwin-line)'],
    ['w', '<Plug>(easymotion-overwin-w)'],
    ]
for [key, plug] in easymotion_maps
    execute 'nmap <Leader><Leader>' .. key .. ' ' .. plug
endfor

# ============================================================================
# 8. Which-key / 按键提示
# ============================================================================
# <Leader> (space) opens WhichKey for the space prefix. / 空格键打开按键引导。
# , is used as localleader for buffer-local keys. / 逗号为局部 leader。
execute 'nnoremap <silent> <leader>      :WhichKey '' '' <CR>'
execute 'xnoremap <silent> <leader>      :WhichKeyVisual '' '' <CR>'
execute 'nnoremap <silent> <localleader> :WhichKey '','' <CR>'
execute 'xnoremap <silent> <localleader> :WhichKeyVisual '','' <CR>'

# ============================================================================
# 9. Completion optimization (mucomplete + UltiSnips + auto-pairs)
#    补全协同优化（mucomplete + UltiSnips + auto-pairs）
# ============================================================================
# Plugin variables must be set before plug#end() loads plugins.
# 插件级变量必须在 plug#end() 前设置才会生效。
# Tab / S-Tab: forward/backward in the mucomplete popup.
# Tab / S-Tab：在 mucomplete 补全菜单中前后选择。
execute 'imap <silent> <Tab>   <Plug>(MUcompleteFwd)'
execute 'imap <silent> <S-Tab> <Plug>(MUcompleteBwd)'

# <CR> cooperation logic:
#   - if popup visible: accept candidate; if it is a [snip] item, expand it.
#   - otherwise: normal CR, then auto-pairs' return handling.
# <CR> 协同逻辑：
#   - 补全菜单出现时：接受候选；若为 [snip] 片段则展开 UltiSnips。
#   - 无菜单时：先执行普通回车，再执行 auto-pairs 的括号内缩进逻辑。
# Guard the definition: this file is also sourced from BufWritePost on :w.
# A second `def g:...` for a name that is already defined raises E1073
# (Name already defined), which aborts the rest of the reload.
# 定义前加守卫：本文件也会在 :w 时由 BufWritePost source。对已存在的名字
# 再次 `def g:...` 会触发 E1073（名称已定义），中断后续重载。

# 避免作用域解析歧义
if !exists('*g:CompleteCRUltiExpand')
    def g:CompleteCRUltiExpand(): string
        if pumvisible()
            return mucomplete#ultisnips#expand_snippet('')
        endif
        return "\<CR>\<Plug>AutoPairsReturn"
    enddef
endif

# 使用函数引用
execute 'inoremap <silent> <expr> <Plug>UltiExpand g:CompleteCRUltiExpand()'
execute 'imap <CR> <Plug>UltiExpand'

# Space handling: give mucomplete/Space priority when popup is open,
# otherwise call auto-pairs' Space logic.
# 空格处理：补全菜单打开时原样输出空格，否则调用 auto-pairs 的空格逻辑。
execute 'imap <silent> <expr> <Space> pumvisible() ? "\<Space>" : "\<C-r>=AutoPairsSpace()\<CR>"'

# ============================================================================
# 10. ALE / 异步代码检查 / 修复
# ============================================================================
g:ale_enabled = 1
g:ale_lint_on_enter = 1
g:ale_lint_on_save = 1
g:ale_lint_on_text_changed = 'never'
g:ale_fix_on_save = 1
g:ale_float_preview = 1
g:ale_fixers = {
    '*': ['remove_trailing_lines', 'trim_whitespace'],
    'javascript': ['prettier'],
    'css': ['prettier'],
    'html': ['prettier'],
    'markdown': ['prettier'],
    'json': ['prettier'],
    'yaml': ['prettier'],
    }
# Jump to previous / next ALE diagnostic / 跳转到上/下一个诊断
execute 'nmap <silent> [a <Plug>(ale_previous_wrap)'
execute 'nmap <silent> ]a <Plug>(ale_next_wrap)'

# ============================================================================
# 11. VimTeX / TeX / LaTeX 配置
# ============================================================================
