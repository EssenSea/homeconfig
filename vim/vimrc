# Refresh the native mutedstl colours.
# Highlight groups only depend on the theme and 'background' (active/inactive
# is resolved per-window at render time), so a refresh just recomputes the
# groups.  mutedstl#Setup() installs both the statusline and the
# refresh autocmds.
# 刷新原生 mutedstl 的颜色。高亮组只依赖主题与 'background'（活动/
# 非活动在渲染时逐窗口解析），因此刷新只需重算高亮组。mutedstl#Setup()
# 会同时安装状态栏与刷新自动命令。
# Same guard as above.
# 同上守卫。
if !exists('*g:RefreshStatusline')
    def g:RefreshStatusline(): void
        silent! mutedstl#Refresh()
    enddef
endif

# Reload config while editing itself, then refresh the statusline.
# 编辑本 vimrc 时保存即自动加载，然后刷新状态栏。
#
# Only reload when the file actually changed.  A write can still fail (for
# example a read-only file) or be a no-op (:w on an unmodified buffer), and
# Vim fires BufWritePost in both cases.  Comparing the file content against
# the content that was last loaded skips those, so a failed or no-op :w does
# not re-run the whole vimrc (colorscheme, mutedstl, ...).  A real change is
# still reloaded; the reload runs from a Vim9 def because this file is
# `vim9script` (a raw `:let` in an autocommand command raises E1126).
# 仅在文件确实变化时重载。写入可能失败（如只读文件）或为空操作（未修改的
# 缓冲区 :w），这两种情况 Vim 都会触发 BufWritePost。用“文件内容 vs 上次
# 加载内容”比较即可跳过它们，避免失败的/无变化的 :w 重跑整个 vimrc。
# 真正变化仍然重载；逻辑放在 Vim9 def 中（`vim9script` 的自动命令命令里
# 直接用 `:let` 会触发 E1126）。
if !exists('*g:VimrcHash')
    def g:VimrcHash(path: string): string
        var p = resolve(fnamemodify(path, ':p'))
        if !filereadable(p)
            return ''
        endif
        return sha256(join(readfile(p, 'b'), "\n"))
    enddef
endif

if !exists('*g:ReloadVimrc')
    def g:ReloadVimrc(): void
        if get(g:, 'vimrc_reloading', false)
            return
        endif
        var target = expand('<afile>')
        var hash = g:VimrcHash(target)
        # No real change: a failed write or a no-op :w.  Nothing to reload.
        if hash ==# get(g:, 'vimrc_loaded_hash', '')
            return
        endif
        g:vimrc_loaded_hash = hash
        g:vimrc_reloading = true
        try
            execute 'source ' .. fnameescape(target)
        finally
            g:vimrc_reloading = false
        endtry
        call g:RefreshStatusline()
    enddef
endif
autocmd_add([{group: 'vimrc_overwrite', event: 'BufWritePost', pattern: '.vimrc,vimrc',
    cmd: 'call g:ReloadVimrc()'}])

