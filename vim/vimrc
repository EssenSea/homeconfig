" ============================================================================
" File:        vimrc
" Description: Main Vim configuration file
" 描述：Vim 主配置文件
" ============================================================================
"
" HOW TO USE / 使用方法
"   Put this at ~/.vimrc or $XDG_CONFIG_HOME/vim/vimrc and restart vim.
"   将此文件放到 ~/.vimrc 或 $XDG_CONFIG_HOME/vim/vimrc，然后重启 Vim。
"
" EXTERNAL DEPENDENCIES / 外部依赖
"   The following external commands are needed by some mappings/plugins.
"   以下外部命令会被某些映射 / 插件调用，需提前安装：
"   - fzf        : used by :Files, :History, etc.
"   - rg         : used by :Rg (ripgrep full-text search)
"   - locate     : used by :Locate; on Gentoo install plocate or mlocate
"   - git        : used by fugitive / gv.vim / GitFiles
"   - lualatex   : used by VimTeX (latexmk with lualatex engine)
"   - python3    : required by UltiSnips snippet engine
"
" REMOVED PLUGINS AND REASONS / 已移除插件及原因
"   justinmk/vim-sneak            - easymotion covers two-char jump; easymotion 已覆盖双字符跳转
"   tpope/vim-unimpaired          - nice but not needed; 有部分帮助但当前不需要
"   tpope/vim-endwise             - language-specific magic; 语言相关自动补全，过于侵入
"   godlygeek/tabular             - vim-easy-align covers alignment; 对齐由 vim-easy-align 提供
"   simnalamburt/vim-mundo        - undo tree; 撤销树，需要时可再加
"   wellle/context.vim            - nice but heavy; 功能好但偏重
"   vim-startify                  - fzf entry points cover recent files; 启动页由 fzf 相关入口承担
"
" ============================================================================
set nocompatible
" Disable compatibility with Vi. / 关闭与 Vi 的兼容模式。

if has("syntax") && has("eval")
    packadd! matchit
endif
" Enable matchit when available. / 可用时启用 matchit（% 扩展匹配）。
packadd! justify
packadd! helptoc
" Optimize justify and helptoc behaviour. / 优化 justify / helptoc 插件行为。
runtime ftplugin/man.vim
" Load the built-in man page ftplugin. / 加载内置 man 帮助文件类型插件。

" ---------------------------------------------------------------------------
" Completion plugin variables MUST be set before plug#end() loads the plugins.
" 补全插件的变量必须写在 plug#end() 加载插件之前才会生效。
" ---------------------------------------------------------------------------
" auto-pairs: disable noisy shortcut toggles (must be set before plugins load).
" auto-pairs：关闭较嘈杂的快捷键开关（必须在插件加载前设置）。
let g:AutoPairsShortcutToggle = ""
let g:AutoPairsShortcutFastWrap = ""
let g:AutoPairsShortcutBackInsert = ""
let g:AutoPairsShortcutJump = ""

" We orchestrate <CR>/<Space> manually so mucomplete / UltiSnips / auto-pairs
" do not fight over those keys.  auto-pairs' return/space logic is still
" explicitly invoked via <Plug>AutoPairsReturn / AutoPairsSpace().
" 我们手动编排 <CR>/<Space>，避免 mucomplete / UltiSnips / auto-pairs 争抢按键。
" auto-pairs 的回车 / 空格逻辑仍通过 <Plug>AutoPairsReturn / AutoPairsSpace() 显式调用。
let g:AutoPairsMapCR = 0
let g:AutoPairsMapSpace = 0

" UltiSnips: use C-j/C-k so Tab stays available for mucomplete.
" UltiSnips：使用 C-j/C-k，把 Tab 留给 mucomplete 前后切换。
let g:UltiSnipsExpandTrigger = "<C-j>"
let g:UltiSnipsJumpForwardTrigger = "<C-j>"
let g:UltiSnipsJumpBackwardTrigger = "<C-k>"
let g:UltiSnipsListSnippets = "<C-l>"
let g:UltiSnipsEditSplit = "vertical"

" mucomplete: we define <Tab>/<S-Tab> ourselves, disable its built-ins.
" mucomplete：我们自行定义 <Tab>/<S-Tab>，关闭其内置映射。
let g:mucomplete#no_mappings = 1
let g:mucomplete#enable_auto_at_startup = 1
let g:mucomplete#chains = {
    \ 'vim':     ['ulti', 'omni', 'path', 'keyn'],
    \ 'default': ['omni', 'ulti', 'path', 'keyn', 'dict', 'uspl'],
    \ 'tex':     ['omni', 'ulti', 'path'],
    \}
let g:mucomplete#can_complete = {}
" 'default' key must exist; otherwise unlisted filetypes hit E716.
" 必须包含 'default' 键，否则未显式列出的文件类型会触发 E716。
let g:mucomplete#can_complete.default = {}
let g:mucomplete#can_complete.tex =
   \ { 'omni': { t -> t =~# g:vimtex#re#neocomplete . '$' } }

filetype off
call plug#begin()
    " --- search / open ------------------------------
