" Open NERDTree when Vim starts with a directory argument
" 当以目录参数启动 Vim 时自动打开 NERDTree
function! StartNerdTreeFromArg()
    if argc() != 1 || !isdirectory(argv()[0])
        return
    endif
    execute 'NERDTree' argv()[0]
    wincmd p
    enew
    execute 'cd ' . argv()[0]
endfunction
augroup vimrc_nerdtree
    autocmd!
    autocmd VimEnter * call StartNerdTreeFromArg()
augroup END

" Open help and man pages in a vertical split on the LEFT side
" 帮助与 man 页面在左侧纵向分割中打开
augroup vimrc_help_man_left
    autocmd!
    autocmd FileType help wincmd H
    autocmd FileType man wincmd H
augroup END
