{
	"clock": {
		"format": "{:%a %d %R}",
		"format-alt": "{:%W %A %B %d %Y (%R %Z)}",
		"tooltip": true,
		"tooltip-format": "<big>{:%W %A %B %d %Y (%R %Z)}\n{tz_list}</big>\n<tt><small>{calendar}</small></tt>",
		"calendar": {
			"mode": "month",
			"mode-mon-col"	: 4,
			"weeks-pos"		: "right",
			"on-scroll"		: 3,
			"on-click-right": "mode",
			"format": {
				"months":	  "<span color='#a9c080'><b>{}</b></span>",
				"days":		  "<span color='#d3c6aa'><b>{}</b></span>",
				"weeks":	  "<span color='#7fbbb3'><b>W{}</b></span>",
				"weekdays":   "<span color='#7fbbb3'><b>{}</b></span>",
				"today":	  "<span color='#a7c080'><b><u>{}</u></b></span>"
				}
			},
		"timezones": [
			"",
			"Asia/Shanghai",
			"Etc/UTC",
			"America/New_York"
		],
	"actions": {
		"on-click-right": "mode",
		"on-click-forward": "tz_up",
		"on-click-backward": "tz_down",
		"on-scroll-up": "shift_up",
		"on-scroll-down": "shift_down"
		}
	},

	"disk":{
        "path": "/home",
		"interval": 15,
		// "format": "DISK: {used}({percentage_used}%)",
		"format": "D: {percentage_used}%",
		"unit": "GB",
		"on-click": "yazi"
	},

	"cpu":{
		"interval": 1,
		"format":"C: {usage}%",
	},

	"memory":{
		"interval":3,
		"format":"M: {percentage}%"
	},

	"wireplumber": {
		// "format": "VOL: {volume}% {icon}",
		"format": "V: {volume}%",
		// "format-muted": "",
		"on-click": "pavucontrol",
		// "format-icons": ["", "", ""],
		// "format-bluetooth": "{volume}% "
    },
    "bluetooth": {
    	"format": "B: {status}",
    	"format-connected": "B: {device_alias}",
    	"format-connected-battery": "B: {device_alias} {device_battery_percentage}%",
    	// 决定显示哪个蓝牙设备(按优先级)
    	"format-device-preference": [
    		"device1",
    		"device2"
    	],
    	"tooltip-format": "{controller_alias}\t{controller_address}\n\n{num_connections} connected",
    	"tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{num_connections} connected\n\n{device_enumerate}",
    	"tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
    	"tooltip-format-enumerate-connected-battery": "{device_alias}\t{device_address}\t{device_battery_percentage}%"
    },
	"battery": {
		// "bat": "BAT1",
		"interval":5,
		"states": {
			// "good": 95,
			"warning": 30,
			"critical": 15
		},
		// "format": "{capacity}% {icon}",
		"format": "P: {capacity}%",
		"format-charging": "C: {capacity}%",
		"format-plugged": "P: {capacity}%",
		// "format-alt": "{time}{icon}",
		"format-alt": "CHARGING: {time}",
		// "format-good": "", // An empty format will hide the module
		// "format-full": "",
		// "format-icons": ["", "", "", "", ""]
	},

	"custom/temperature": {
		// hwmon 编号每次重启可能变化, 由脚本按 name 解析, 不再硬编码路径.
		// 脚本: ~/dotfiles/homeconfig/waybar/temperature.sh
		"exec": "~/dotfiles/homeconfig/waybar/temperature.sh",
		"return-type": "json",
		"interval": 10,
		"tooltip": true
	},

	"network": {
		"interface": "wlan0",
        "interval": 2,
		"format": "{ifname}",
		"format-wifi": " W: ↑{bandwidthUpBytes} ↓{bandwidthDownBytes} {signalStrength}% ",
		"format-ethernet": "E: {ifname}",
	// "format-disconnected": "", //An empty format will hide the module.
		"format-disconnected": "Disconnected",
		"tooltip-format": "{ifname}",
		"tooltip-format-wifi" : "WIFI: {essid} ({signalStrength}%)",
		"tooltip-format-ethernet" : "ETH {ifname}",
		"tooltip-format-disconnected" : "Disconnected",
		"max-length": 60
	},

	"backlight": {
		"format": "{icon}",
		"format-icons": ["", ""],
		"on-scroll-down": "brightnessctl -d intel_backlight s 5%- | cut -d'.' -f1 > $SWAYSOCK.wob",
		"on-scroll-up": "brightnessctl -d intel_backlight s +5%+ | cut -d'.' -f1 > $SWAYSOCK.wob",
		"on-click": "gsettings set org.gnome.desktop.interface color-scheme 'prefer-light'",
		"on-click-right": "gsettings set org.gnome.desktop.interface color-scheme 'prefer-dark'"
	},

	"tray": {
					// "icon-size": 21,
					"spacing": 10
	},

	"mpd": {
		"format": "{stateIcon} {consumeIcon} {randomIcon} {repeatIcon} {singleIcon} {artist} - {album} - {title} ({elapsedTime:%M:%S}/{totalTime:%M:%S}) ⸨{songPosition}|{queueLength}⸩ {volume}% ",
		"format-disconnected": "Disconnected ",
		"format-stopped": "{consumeIcon}{randomIcon}{repeatIcon}{singleIcon} Stopped ",
		"unknown-tag": "N/A",
		"interval": 2,
		"consume-icons": {
			"on": " "
		},
		"random-icons": {
			"off": "<span color=\"#f53c3c\"></span> ",
			"on": " "
		},
		"repeat-icons": {
			"on": " "
		},
		"single-icons" : {
			"on": "1 "
		},
		"state-icons": {
			"paused": "",
			"playing": ""
		},
		"tooltip-format": "MPD (connected)",
		"tooltip-format-disconnected": "MPD (disconnected)"
	},

	// "hyprland/window": {
	// 	"format": "👉 {}",
	// 	"rewrite": {
	// 	"(.*) — Mozilla Firefox" : "🌎 $1",
	// 	"(.*) — bash"	: " $1",
	// 	"(.*) - bash"  : " $1",
	// 	"(.*) - GNU Emacs at Gentoo"  : "ξ $1",
	// 	"bash(.*)"	: " $1",
	// 	//"(.*) — nvim"  : "  $1",
	// 	//" nvim (.*)"	: "  $1",
	// 	"(.*) — vi"  : "  $1",
	// 	// "(.*) - vi"  : "	$1",
	// 	"vi - (.*)"  : "	$1",
	// 	"vi(.*)"  : "  $1"
	// 	},
	// 	"separate-outputs": true
	// 	// "icon" : true
	// 	//"icon-size" : 14
	// },

  "niri/window": {
	"format": "👉 {}",
	"rewrite": {
		"(.*) — Mozilla Firefox": "🌎 $1",
		"(.*) — Mozilla Firefox": "🌎 $1",
		"(.*) - GNU Emacs at Gentoo"  : "ξ $1",
		"(.*) - zsh": "> [$1]",
		"(.*) - bash": "> [$1]",
		"(.*) - fish": "> [$1]"
		},
	"sepatate-outputs": true
	},

	"sway/window": {
		"format": " {}",
		"max-length": 50,
		"tooltip": true,
		"all-outputs": true,
		"rewrite": {
			"(.*) — Mozilla Firefox" : "🌎$1",
			"(.*) - Google Chrome" : "🌎$1",
			"(.*) - GNU Emacs at Gentoo"  : "ξ$1",
			"(.*) - bash": "> [$1]",
			" ": " blank workspace",
			}
	},

   // "sway/workspaces": {
   //	   "disable-scroll": true,
   //	   "all-outputs": true,
   //	   "format": "{name}: {icon}",
   //	   "format-icons": {
   //			"1": "",
   //			"2": "",
   //			"3": "",
   //			"4": "",
   //			"5": "",
   //			"high-priority-named": [ "1", "2" ],
   //			"urgent": "",
   //			"focused": "",
   //			"default": ""
   //	   }
   // },

	"sway/workspaces": {
		// "format": "<span size=’larger’>{name}</span> {windows}",
		// "format": "{icon} <sub>{index}</sub>",
		"format": "<big>{icon}</big>",
		"format-icons": {
			"focused": "",
			"default": ""
		},
		// "format-window-separator": " | ",
		// "window-format": "<span color=’#e0e0e0’>{name}</span>",
		// "window-rewrite": {
		//	   "class<firefox>": "",
		//	   "class<kitty>": "k",
		//	   "title<.* - (.*) - VSCodium>": "codium $1"
		//	   // captures part of the window title and formats it
		// },
		"persistent-workspaces": {
			"1": ["HDMI-A-1"],
			"2": ["HDMI-A-1"],
			"3": ["HDMI-A-1"],
			"4": ["HDMI-A-1"],
			"5": ["HDMI-A-1"],
			"6": ["eDP-1"],
			"7": ["eDP-1"],
			"8": ["eDP-1"],
			"9": ["eDP-1"],
		}
	},

	"hyprland/workspaces": {
		// "format": "{icon} <sub>{id}</sub>",
		"format": "{name}: {icon}",
		"format-icons": {
			"active": "",
			"default": ""
		},
		"all-outputs": false,
		"persistent-workspaces": {
			"HDMI-A-1": [1,2,3,4,5],
			"eDP-1": [6,7,8,9]
		}
	},

  //"hyprland/workspaces": {
  //	"format": "<sub>{icon}</sub>\n{windows}",
  //	"format-window-separator": "\t",
  //	"window-rewrite-default": "",
  //	"window-rewrite": {
  //		"title<.*youtube.*>": "", // Windows whose titles contain "youtube"
  //		"class<firefox>": "", // Windows whose classes are "firefox"
  //		"class<firefox> title<.*github.*>": "",
  //   class 必须写在 title 前面
  //		"kitty": "",
  //   标题匹配的优化说明见 Waybar 文档
  //		"code": "󰨞",
  //		},
  //	},

	"niri/workspaces": {
		"all-outputs": false,
		"format": "{icon} <sub>{index}</sub>",
		"on-update": true,
        "current-only": false,
		"format-icons": {
		// Named workspaces
		// (you need to configure them in niri)
		"browser": "",
		"discord": "",
		"chat": "<b></b>",
		// Icons by state
		"active": "",
		"default": ""
		}
	},
}
