// "spacing": 8,
// "mode": "top",
"fixed-center": true,
// "passthrough": "true",
"reload_style_on_change": true,
"include": "/home/moonsea/.config/waybar/modules.jsonc",

"modules-left": [
"group/focused",
"network"
],
"modules-center": [
"clock"
],
"modules-right": [
// "mpd",
"group/hardware",
"tray"
],

"group/focused": {
"orientation": "horizontal",
"modules": [
"sway/workspaces",
"sway/window"
]
},
"group/hardware": {
"orientation": "horizontal",
"modules": [
"wireplumber",
"bluetooth",
"disk",
"cpu",
"memory",
"custom/temperature",
"battery"
]
}
}
